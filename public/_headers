# Face Console Production Web — cache headers for Cloudflare Pages / static hosts.
# Hashed assets may be immutable; index.html must revalidate so users pick up new builds.

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/mediapipe/*
  Cache-Control: public, max-age=86400

/models/*
  Cache-Control: public, max-age=86400
