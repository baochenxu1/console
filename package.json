{
  "name": "servo-face-console",
  "private": true,
  "version": "0.2.0-beta",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:voice-api": "node server/voice/server.mjs",
    "dev:companion": "node server/voice/companion/companionServer.mjs",
    "build:companion-win": "node scripts/companion/build-win-exe.mjs",
    "verify:companion-win": "node scripts/companion/verify-win-pack.mjs",
    "test:voice-companion-xinqi-root": "node server/voice/companion/resolveXinqiRoot.selftest.mjs",
    "companion:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/companion/install-autostart-windows.ps1",
    "companion:autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/companion/install-autostart-windows.ps1 -Uninstall",
    "test:voice-token": "node server/voice/voiceToken.selftest.mjs",
    "test:voice-env": "node server/voice/voiceEnv.selftest.mjs",
    "test:voice-assemblyai": "node src/sdk/voice/providers/assemblyAIProvider.selftest.mjs",
    "test:voice-deepgram": "node src/sdk/voice/providers/deepgramProvider.selftest.mjs",
    "test:voice-xinqi-gateway": "node server/voice/xinqi/xinqiGateway.selftest.mjs",
    "test:voice-xinqi": "node src/sdk/voice/providers/xinqiProvider.selftest.mjs",
    "test:voice-companion": "node server/voice/companion/companion.selftest.mjs",
    "test:voice-companion-discovery": "node src/sdk/voice/companion/companionDiscovery.selftest.mjs",
    "verify:companion-p0": "node scripts/companion/p0-cross-origin-verify.mjs",
    "verify:companion-p0-browser": "node scripts/companion/p0-browser-lna-verify.mjs",
    "test:voice-output": "node src/sdk/audio/voiceOutputRuntime.selftest.mjs",
    "build": "vite build",
    "build:sdk": "vite build --config vite.sdk.config.js",
    "prepare:mediapipe-assets": "node scripts/prepare-browser-mediapipe-assets.mjs",
    "build:faceconsole-web": "node scripts/prepare-browser-mediapipe-assets.mjs && vite build --config vite.faceconsole-web.config.js && node scripts/check-faceconsole-web-assets.mjs",
    "preview:faceconsole-web": "vite preview --config vite.faceconsole-web.config.js --host 127.0.0.1 --port 4173",
    "check:faceconsole-web-assets": "node scripts/check-faceconsole-web-assets.mjs",
    "smoke:faceconsole-web-https": "node scripts/smoke-faceconsole-web-https.mjs",
    "test:browser-tracking": "node --test src/sdk/tracking/browser/*.test.mjs",
    "test:tracking-semantic": "node --test src/sdk/tracking/core/*.test.mjs src/sdk/tracking/browser/*.test.mjs",
    "test:gaze-diagnostic": "node --test src/sdk/tracking/diagnostics/gazeDiagnosticPhase1.test.mjs src/sdk/tracking/diagnostics/gazeShadowComparePhase1.test.mjs",
    "test:gaze-shadow": "node --test src/sdk/tracking/diagnostics/gazeShadowComparePhase1.test.mjs",
    "test:gaze-v2": "node --test src/sdk/tracking/core/eyeLocalGazeV2.test.mjs src/sdk/tracking/core/headCanonicalEyeGeometry.test.mjs src/sdk/tracking/eyeXYStabilizer.test.mjs",
    "analyze:gaze-diagnostic": "node scripts/analyze-gaze-diagnostic.mjs",
    "smoke:browser-mediapipe-worker": "node scripts/smoke-browser-mediapipe-worker-init.mjs",
    "smoke:browser-mediapipe-worker:browser": "node scripts/smoke-browser-mediapipe-worker-init.mjs --browser",
    "pack:sdk": "node scripts/prepare-sdk-package.mjs && npm pack ./dist-sdk-package",
    "preview": "vite preview",
    "tree:clean": "node scripts/print-project-tree.mjs",
    "tree:docs": "node scripts/print-project-tree.mjs --out docs/PROJECT_TREE.md",
    "dist:zip": "node scripts/make-distribution-zip.mjs",
    "dist:release": "npm run pack:sdk && node scripts/make-distribution-zip.mjs",
    "dist:faceconsole": "node scripts/make-camera-tracking-release.mjs",
    "setup:faceconsole": "powershell -NoProfile -ExecutionPolicy Bypass -File release/setup-camera-tracking.ps1",
    "start:faceconsole": "powershell -NoProfile -ExecutionPolicy Bypass -File release/start-camera-tracking.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "vite": "^5.4.10"
  }
}
